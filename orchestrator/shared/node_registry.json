{
  "version": "1.0.0",
  "categories": [
    {
      "id": "trigger",
      "label": "Triggers",
      "description": "Entry points that start a workflow execution"
    },
    {
      "id": "agent",
      "label": "AI Agents",
      "description": "LLM-powered reasoning nodes"
    },
    {
      "id": "action",
      "label": "Actions",
      "description": "Tool calls, HTTP requests, and side-effect operations"
    },
    {
      "id": "logic",
      "label": "Logic",
      "description": "Branching, merging, and flow control nodes"
    }
  ],
  "node_types": [
    {
      "type": "webhook_trigger",
      "category": "trigger",
      "label": "Webhook Trigger",
      "description": "Start workflow on HTTP POST",
      "icon": "webhook",
      "config_schema": {
        "method": { "type": "string", "default": "POST", "enum": ["POST", "PUT"] },
        "path": { "type": "string", "default": "/webhook" }
      }
    },
    {
      "type": "schedule_trigger",
      "category": "trigger",
      "label": "Schedule Trigger",
      "description": "Start workflow on a cron schedule",
      "icon": "clock",
      "config_schema": {
        "cron": { "type": "string", "default": "0 * * * *" }
      }
    },
    {
      "type": "llm_agent",
      "category": "agent",
      "label": "LLM Agent",
      "description": "AI reasoning node with prompt and model selection",
      "icon": "brain",
      "config_schema": {
        "provider": { "type": "string", "default": "google", "enum": ["google", "openai", "anthropic"] },
        "model": { "type": "string", "default": "gemini-2.5-flash", "enum": ["gemini-2.5-flash", "gemini-2.5-pro", "gpt-4o", "gpt-4o-mini", "claude-sonnet-4-20250514", "claude-3-5-haiku-20241022"] },
        "systemPrompt": { "type": "string", "default": "" },
        "temperature": { "type": "number", "default": 0.7, "min": 0, "max": 2 },
        "maxTokens": { "type": "integer", "default": 4096 }
      }
    },
    {
      "type": "react_agent",
      "category": "agent",
      "label": "ReAct Agent",
      "description": "Iterative tool-calling agent loop",
      "icon": "repeat",
      "config_schema": {
        "provider": { "type": "string", "default": "google", "enum": ["google", "openai", "anthropic"] },
        "model": { "type": "string", "default": "gemini-2.5-flash", "enum": ["gemini-2.5-flash", "gemini-2.5-pro", "gpt-4o", "gpt-4o-mini", "claude-sonnet-4-20250514", "claude-3-5-haiku-20241022"] },
        "systemPrompt": { "type": "string", "default": "" },
        "maxIterations": { "type": "integer", "default": 10 },
        "tools": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    {
      "type": "mcp_tool",
      "category": "action",
      "label": "MCP Tool",
      "description": "Execute an MCP server tool",
      "icon": "wrench",
      "config_schema": {
        "toolName": { "type": "string", "default": "" },
        "parameters": { "type": "object", "default": {} }
      }
    },
    {
      "type": "http_request",
      "category": "action",
      "label": "HTTP Request",
      "description": "Make an external HTTP call",
      "icon": "globe",
      "config_schema": {
        "url": { "type": "string", "default": "" },
        "method": { "type": "string", "default": "GET", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "headers": { "type": "object", "default": {} },
        "body": { "type": "string", "default": "" }
      }
    },
    {
      "type": "human_approval",
      "category": "action",
      "label": "Human Approval",
      "description": "Pause and wait for human approval",
      "icon": "user-check",
      "config_schema": {
        "approvalMessage": { "type": "string", "default": "" },
        "timeout": { "type": "integer", "default": 3600 }
      }
    },
    {
      "type": "condition",
      "category": "logic",
      "label": "Condition",
      "description": "Branch based on a condition expression",
      "icon": "git-branch",
      "config_schema": {
        "condition": { "type": "string", "default": "" },
        "trueLabel": { "type": "string", "default": "Yes" },
        "falseLabel": { "type": "string", "default": "No" }
      }
    },
    {
      "type": "merge",
      "category": "logic",
      "label": "Merge",
      "description": "Merge multiple branches",
      "icon": "git-merge",
      "config_schema": {
        "strategy": { "type": "string", "default": "waitAll", "enum": ["waitAll", "waitAny"] }
      }
    },
    {
      "type": "forEach",
      "category": "logic",
      "label": "ForEach",
      "description": "Iterate over an array, executing downstream nodes once per element",
      "icon": "repeat",
      "config_schema": {
        "arrayExpression": { "type": "string", "default": "" },
        "itemVariable": { "type": "string", "default": "item" }
      }
    },
    {
      "type": "load_conversation_state",
      "category": "action",
      "label": "Load Conversation State",
      "description": "Fetch multi-turn chat history from persistent storage. Place this as the first node after the trigger to enable conversational memory.",
      "icon": "history",
      "config_schema": {
        "sessionIdExpression": {
          "type": "string",
          "default": "trigger.session_id",
          "description": "Expression that resolves to the session identifier (e.g. trigger.session_id)"
        }
      }
    },
    {
      "type": "save_conversation_state",
      "category": "action",
      "label": "Save Conversation State",
      "description": "Append the current user message and assistant response to persistent chat history. Place this as the last node in the graph.",
      "icon": "save",
      "config_schema": {
        "sessionIdExpression": {
          "type": "string",
          "default": "trigger.session_id",
          "description": "Expression that resolves to the session identifier"
        },
        "responseNodeId": {
          "type": "string",
          "default": "",
          "description": "Node ID whose 'response' field is saved as the assistant message (e.g. node_4)"
        },
        "userMessageExpression": {
          "type": "string",
          "default": "trigger.message",
          "description": "Expression that resolves to the user's current message text"
        }
      }
    },
    {
      "type": "llm_router",
      "category": "agent",
      "label": "LLM Router",
      "description": "Classifies the user's intent into one of the configured intent labels. Outputs {intent: string} for downstream Condition nodes to route on.",
      "icon": "route",
      "config_schema": {
        "provider": { "type": "string", "default": "google", "enum": ["google", "openai", "anthropic"] },
        "model": { "type": "string", "default": "gemini-2.5-flash", "enum": ["gemini-2.5-flash", "gemini-2.5-pro", "gpt-4o", "gpt-4o-mini", "claude-sonnet-4-20250514", "claude-3-5-haiku-20241022"] },
        "intents": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Valid intent names the router can output (e.g. diagnose_server, casual_chat, escalate)"
        },
        "historyNodeId": {
          "type": "string",
          "default": "",
          "description": "Node ID of the Load Conversation State node to read history from (e.g. node_1)"
        },
        "userMessageExpression": {
          "type": "string",
          "default": "trigger.message",
          "description": "Expression that resolves to the current user message text"
        }
      }
    }
  ]
}
